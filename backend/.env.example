APP_NAME=FlowPilot AI Backend
API_PREFIX=/api
FRONTEND_ORIGIN=http://localhost:5173
ENV=development
N8N_WEBHOOK_BASE_URL=http://localhost:5678/webhook
LEAVE_N8N_WEBHOOK_BASE_URL=http://localhost:5678/webhook
LEAVE_BALANCE_PRECHECK_WEBHOOK_URL=http://localhost:5678/webhook/flowpilot/leave/balance-precheck
FLOWPILOT_N8N_SHARED_SECRET=flowpilot-test-secret
FLOWPILOT_API_BASE_URL_FOR_N8N=http://host.docker.internal:8000
ODOO_BASE_URL=http://host.docker.internal:8069
ODOO_DB=flowpilot_odoo
ODOO_UID=2
ODOO_PASSWORD=123456789

# PostgreSQL Docker database
POSTGRES_DB=flowpilot_db
POSTGRES_USER=flowpilot_user
POSTGRES_PASSWORD=flowpilot_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://flowpilot_user:flowpilot_password@localhost:5432/flowpilot_db

# OpenRouter (Mistral) — moteur de Generative UI + fallback texte de l'assistant.
# Colle ta clé OpenRouter ici (format sk-or-v1-...). Vide = fallback templates.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=mistralai/mistral-small-3.2-24b-instruct
OPENROUTER_TIMEOUT_SECONDS=30
OPENROUTER_MAX_TOKENS=800

# OpenUI Generative UI for Assistant IA.
OPENUI_ENABLED=false
# Laisser vide pour réutiliser OPENROUTER_MODEL (Mistral) ci-dessus.
OPENUI_MODEL=
OPENUI_TIMEOUT_SECONDS=30
OPENUI_MAX_TABLE_ROWS=20
