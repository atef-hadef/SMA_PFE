POSTGRES_DB=flowpilot_db
POSTGRES_USER=flowpilot_user
POSTGRES_PASSWORD=flowpilot_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://flowpilot_user:flowpilot_password@localhost:5432/flowpilot_db
JWT_SECRET_KEY=change-this-local-development-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# OpenRouter LLM fallback (used only for open-ended / unknown questions).
# Leave OPENROUTER_API_KEY empty to disable the LLM fallback; the assistant
# will gracefully revert to its static answers.
OPENROUTER_API_KEY=sk-or-REMPLACEZ-PAR-VOTRE-CLE
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=mistralai/mistral-7b-instruct
OPENROUTER_TIMEOUT_SECONDS=30
OPENROUTER_MAX_TOKENS=800

# OpenUI Generative UI for Assistant IA.
# When disabled, the assistant keeps the legacy answer + visualization renderer.
OPENUI_ENABLED=false
OPENUI_MODEL=
OPENUI_TIMEOUT_SECONDS=30
OPENUI_MAX_TABLE_ROWS=20

# n8n CRM workflows — base URLs used by Code/HTTP nodes inside n8n.
# FLOWPILOT_API_BASE_URL: how n8n reaches the FastAPI backend.
#   - Docker: http://host.docker.internal:8000
#   - Local n8n + local backend: http://localhost:8000
#   - Prod: https://api.votreentreprise.com
FLOWPILOT_API_BASE_URL=http://host.docker.internal:8000
# FLOWPILOT_FRONTEND_URL: public URL of the React frontend, used in email links.
FLOWPILOT_FRONTEND_URL=https://votre-frontend.com
# CRM_DEAL_NOTIFY_EMAIL: recipient for won/lost deal notifications sent by WF07.
# If unset, WF07 throws an explicit error rather than mailing a fake address.
CRM_DEAL_NOTIFY_EMAIL=manager@votreentreprise.com
# CRM_REPORT_MANAGER_EMAIL: recipient for the weekly CRM report sent by WF08.
# If unset, WF08 throws an explicit error rather than mailing a fake address.
CRM_REPORT_MANAGER_EMAIL=manager@votreentreprise.com
